{
  "name": "sama",
  "private": true,
  "version": "1.3.0",
  "description": "SAMA machine-tool maintenance and electrical engineering workstation",
  "author": "SAMA",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:toolpath": "npx tsx scripts/test-toolpath.mts",
    "test:grind": "npx tsx scripts/test-grind-gcode.mts",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "seed:kb": "node scripts/seed-kb.mjs",
    "import:kb": "node scripts/import-web-kb.mjs",
    "import:mtkb": "node scripts/import-mtkb-from-zip.mjs",
    "import:circuit": "node scripts/import-circuit-kb.mjs",
    "smoke:mtkb": "node scripts/smoke-mtkb.mjs",
    "rebuild:kb": "node scripts/rebuild-kb.mjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && node scripts/pack-mac.mjs",
    "dist:mac:native": "npm run build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "png2icons": "^2.0.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.3",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.sama.app",
    "productName": "SAMA",
    "copyright": "Copyright © SAMA",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "electron/resources/lad",
        "to": "lad"
      },
      {
        "from": "resources/mtkb",
        "to": "mtkb"
      },
      {
        "from": "electron/resources/grind-packs",
        "to": "grind-packs"
      },
      {
        "from": "resources/sama-workbench",
        "to": "sama-workbench"
      },
      {
        "from": "electron/resources/eplan-bridge",
        "to": "eplan-bridge"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll}"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SAMA-${version}-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "SAMA-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "SAMA ${version}"
    }
  }
}
